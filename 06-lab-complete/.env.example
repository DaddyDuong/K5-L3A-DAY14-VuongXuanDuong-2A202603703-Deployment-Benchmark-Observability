# Server configuration
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security — replace with a strong random secret in .env (never commit .env)
AGENT_API_KEY=change-me-to-a-strong-random-key

# Redis connection for stateless rate limiting and cost tracking
REDIS_URL=redis://localhost:6379/0

# Protection limits
RATE_LIMIT_PER_MINUTE=10
DAILY_BUDGET_USD=1.0
MONTHLY_BUDGET_USD=30.0
